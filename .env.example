# Server-only. Copy to .env.local only if that file does not already exist.
# Never use NEXT_PUBLIC_ for these values. Replace placeholders privately.
RESEND_API_KEY=
NOTIFICATION_TO_EMAIL=
# A bare email or quoted display name + email on a domain verified in Resend:
NOTIFICATION_FROM_EMAIL="Wavedo Private Coaching <apply@your-verified-domain.com>"

# Stripe: test key for local/Preview, live key only for Production after testing.
STRIPE_SECRET_KEY=
# Signing secret from the matching Stripe webhook endpoint (not an API key).
STRIPE_WEBHOOK_SECRET=
# Neon connection URL. POSTGRES_URL is also supported if provided by the integration.
DATABASE_URL=
